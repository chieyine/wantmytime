# WantMyTime. Production: PUBLIC_APP_ORIGIN=https://wantmytime.com (and ORIGIN
# for the web server). Local development uses the addresses below.
APP_ENV=local
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
API_ADDR=127.0.0.1:8081
# Web server (SvelteKit) reaches the API privately for server-side loads.
API_INTERNAL_BASE=http://127.0.0.1:8081
# Set true only when the API is reachable solely through a trusted proxy (per-IP rate limits).
TRUST_PROXY_HEADERS=false

# PostgreSQL runtime persistence. The API refuses to start without a database.
DATABASE_URL=postgres://aside:aside@localhost:54329/aside?sslmode=disable
# Directory of SQL migrations used by `aside-api migrate`.
MIGRATION_DIR=migrations

# Financial and provider gates. Leave off until explicit owner/provider approval.
PAYMENTS_ENABLED=false
PAYMENT_ENV=sandbox
LIVE_PAYMENTS_ENABLED=false
CHECKOUTS_PAUSED=true
PAYMENT_APPROVAL_ID=
LOCAL_PAYMENT_SIMULATOR=false
# Minutes a time stays held once provider checkout opens (10-60, default 30).
CHECKOUT_HOLD_MINUTES=30
# Kora (korapay.com): sk_test_/pk_test_ keys outside production, sk_live_/pk_live_
# in production. Buyers pay WantMyTime in full (bank transfer first, then pay with
# bank; mobile money in Ghana and Kenya; no cards); the seller's share is held and transferred to their bank after
# the session.
KORA_SECRET_KEY=
KORA_PUBLIC_KEY=
PAYMENT_ROUTE=hold_payout
# Encrypts sellers' bank account numbers (base64 of 32 random bytes).
# Required in production; never change it without re-encrypting accounts.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# Hours after a pay-with-bank or mobile money payment before its money counts
# as settled (default 24; weekends are skipped). Bank transfers settle instantly.
SETTLEMENT_WAIT_HOURS=24
# Minutes after a session ends that the buyer can report a problem or a
# no-show, and after which the seller is paid (payout comes at least 30
# minutes after the window closes).
DISPUTE_WINDOW_MINUTES=120
PAYOUT_DELAY_MINUTES=180
# Emergency stop for transfers. Payouts wait and go out once lifted.
PAYOUTS_PAUSED=false
# When a seller hasn't added a meeting link 30 minutes before a booking,
# WantMyTime creates a video call link and emails it to both people.
AUTO_MEETING_LINKS=true
# Where created links live (default https://meet.jit.si/, no account needed).
MEETING_LINK_BASE=https://meet.jit.si/
FEE_POLICY_MODE=all_in_seller_deduction
FEE_BPS=500
FEE_POLICY_APPROVED=false

# Countries sellers can be based and paid in (each fixes the seller's
# currency). NG is on by default; GH, KE and ZA are built in and switch on
# here once Kora has enabled collection and payouts for them. Buyers can
# come from anywhere.
SELLER_COUNTRIES=NG
# Smallest and largest payment per currency, in minor units. The plain names
# are Nigeria's (kobo); other currencies use a _<CURRENCY> suffix.
MIN_CHARGE_MINOR=
MAX_CHARGE_MINOR=
# MIN_CHARGE_MINOR_GHS=
# MAX_CHARGE_MINOR_GHS=
# MIN_CHARGE_MINOR_KES=
# MAX_CHARGE_MINOR_KES=
# How buyers can pay, per currency. Nigeria: bank_transfer (always offered
# first), pay_with_bank. Ghana and Kenya: mobile_money. Cards are not
# accepted. Kora adds its own fee for the buyer; a fee schedule per channel
# is optional and only shows buyers an estimate first
# (docs/DEPLOYMENT.md).
APPROVED_PAYMENT_CHANNELS=bank_transfer,pay_with_bank
# APPROVED_PAYMENT_CHANNELS_GHS=mobile_money
# APPROVED_PAYMENT_CHANNELS_KES=mobile_money
# Send refunds to Kora automatically (cancellations under policy, seller
# cancellations, confirmed seller no-shows, and payments that could not
# become a booking). On unless set to false: then each refund waits in
# Operations > Refunds for approval.
REFUNDS_ENABLED=true
# Hours a seller has to answer a buyer's problem report (refund in full,
# refund part, or disagree). No answer refunds the buyer in full; only a
# disagreement comes to Operations.
PROBLEM_RESPONSE_HOURS=24
# Largest share of a seller's payout on one booking that repays earlier
# refunds, in basis points (5000 = half).
REFUND_RECOVERY_MAX_BPS=5000

# Identity/email controls. Configure these before production use.
SESSION_SECRET=
OTP_PEPPER=
OPS_MFA_ENCRYPTION_KEY=
MEETING_LINK_ENCRYPTION_KEY=
# Inject only for the one-time bootstrap command; never keep this in a saved env file.
OPS_BOOTSTRAP_TOTP_SECRET=
EMAIL_PROVIDER=disabled
# Production example: WantMyTime <bookings@wantmytime.com> (verify the domain
# with the email provider first: SPF, DKIM and DMARC records in DNS).
EMAIL_FROM=
EMAIL_API_KEY=
# Optional support address for replies to booking emails. Leave empty to keep
# replies unmonitored (the emails say so).
EMAIL_REPLY_TO=

# Phone and browser notifications (self-hosted web push, no third party).
# Generate once with `aside-api vapid-keys` and keep them for good: changing
# them turns notifications off on every device until people switch them on
# again. Leave empty to keep notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@wantmytime.com
# Local development only: print sign-in codes to the API log when no sender works.
ALLOW_LOG_OTP=false
SMTP_HOST=mailpit
SMTP_PORT=1025

# Google Calendar and Meet for sellers (optional). Create a "Web application"
# OAuth client in Google Cloud with the redirect URI
#   <PUBLIC_APP_ORIGIN>/api/v1/integrations/google/callback
# and enable the Google Calendar API. See docs/DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# base64 of 32 random bytes; encrypts sellers' Google refresh tokens.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Observability. All optional; everything still logs as JSON to stdout without them.
# LOG_LEVEL=debug also logs health checks and metric scrapes.
LOG_LEVEL=info
# Version string attached to error reports (for example the git commit).
APP_RELEASE=
# Sentry-compatible DSN for API and server-side web errors (free tier is enough).
SENTRY_DSN=
# Browser error reporting. Use a separate Sentry project or the same DSN.
PUBLIC_SENTRY_DSN=
PUBLIC_APP_ENV=local
PUBLIC_APP_RELEASE=
# Bearer token for GET /metrics on the API. Empty disables the endpoint (404).
# The gateway never exposes /metrics publicly; scrape the API port privately.
METRICS_TOKEN=
# Comma-separated addresses that receive operational alert emails
# (stuck payments, failed deliveries, stalled workers). Needs a working email provider.
ALERT_EMAILS=

# Backups (infrastructure/backup). Local directory or mounted volume for dumps.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Optional off-site copy (Cloudflare R2 or any S3-compatible store). Credentials
# are passed to the backup container only.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Shared rate limits across API instances. Compose runs a local Redis; in
# production use a managed one (rediss:// for TLS). Empty: per-instance limits.
REDIS_URL=

# Profile photos in Cloudflare R2 (S3 API). Empty: photos stay in PostgreSQL.
# Use a token with Object Read & Write on this bucket only.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=auto
# Optional public domain connected to the bucket, e.g. https://media.wantmytime.com.
# Set the same value as PUBLIC_MEDIA_BASE_URL for the web server (Content Security Policy).
MEDIA_PUBLIC_BASE_URL=
PUBLIC_MEDIA_BASE_URL=
